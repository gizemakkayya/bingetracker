// ── Prisma Schema for BingeTracker v2.0 ─────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String
  avatarUrl     String?
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  watchlist     WatchlistItem[]
  reviews       Review[]
  activities    Activity[]
  notifications Notification[]
  
  following     Follow[]       @relation("UserFollowing")
  followers     Follow[]       @relation("UserFollowers")

  @@index([username])
  @@index([email])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model WatchlistItem {
  id              String       @id @default(uuid())
  userId          String
  tmdbId          Int
  mediaType       String       // "movie" | "tv"
  title           String
  posterPath      String?
  status          String       // "watchlist" | "watching" | "watched" | "dropped"
  rating          Int?         // 1 - 10
  notes           String?
  currentSeason   Int?         @default(1)
  currentEpisode  Int?         @default(1)
  totalSeasons    Int?
  totalEpisodes   Int?
  runtimeMinutes  Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodesWatched WatchedEpisode[]

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, status])
}

model WatchedEpisode {
  id              String        @id @default(uuid())
  watchlistItemId String
  seasonNumber    Int
  episodeNumber   Int
  watchedAt       DateTime      @default(now())

  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@unique([watchlistItemId, seasonNumber, episodeNumber])
  @@index([watchlistItemId])
}

model Review {
  id              String    @id @default(uuid())
  userId          String
  tmdbId          Int
  mediaType       String    // "movie" | "tv"
  content         String
  rating          Int       // 1 - 10
  containsSpoiler Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbId, mediaType])
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  type        String       // "WATCHED_EPISODE" | "WATCHED_MOVIE" | "RATED" | "REVIEWED" | "STARTED_SERIES"
  mediaTitle  String
  tmdbId      Int
  mediaType   String       // "movie" | "tv"
  seasonNum   Int?
  episodeNum  Int?
  ratingVal   Int?
  reviewText  String?
  posterPath  String?
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  actorId     String
  type        String   // "NEW_FOLLOWER" | "REVIEW_LIKE" | "FRIEND_WATCHED"
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
